{
  "name": "claujev",
  "version": "1.0.0",
  "description": "O Jev (TypeSafe AI) como segundo par de olhos do Claude Code: hooks que classificam pedidos, revisam edições, seguram comandos perigosos e conferem o trabalho antes de encerrar.",
  "type": "module",
  "license": "MIT",
  "author": "Alisson Civalski",
  "repository": { "type": "git", "url": "git+https://github.com/Civalski/claujev.git" },
  "keywords": ["claude-code", "hooks", "jev", "typesafe-ai", "ai-agents", "guardrails"],
  "engines": { "node": ">=20" },
  "scripts": {
    "install-hooks": "node install.mjs",
    "uninstall-hooks": "node install.mjs --uninstall",
    "selftest": "node hooks/claujev.mjs selftest",
    "report": "node hooks/claujev.mjs report",
    "test": "node --test test/claujev.test.mjs"
  }
}
